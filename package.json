{
  "name": "@lossless-group/lfm",
  "version": "0.11.0",
  "description": "Lossless Flavored Markdown — a polyglot extended markdown pipeline for remark/rehype",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./formats": {
      "import": "./dist/formats/index.js",
      "types": "./dist/formats/index.d.ts"
    },
    "./resolve-path": {
      "import": "./dist/utils/resolve-path.js",
      "types": "./dist/utils/resolve-path.d.ts"
    },
    "./highlight": {
      "import": "./dist/highlight.js",
      "types": "./dist/highlight.d.ts"
    },
    "./formats/yang": {
      "import": "./dist/formats/yang.js",
      "types": "./dist/formats/yang.d.ts"
    },
    "./formats/json-schema": {
      "import": "./dist/formats/json-schema.js",
      "types": "./dist/formats/json-schema.d.ts"
    },
    "./formats/plantuml": {
      "import": "./dist/formats/plantuml.js",
      "types": "./dist/formats/plantuml.d.ts"
    }
  },
  "bin": {
    "lfm-tasks": "dist/cli/lfm-tasks.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:only": "node --test test/*.test.mjs",
    "lfm:gh": "pnpm build && if npm view \"@lossless-group/lfm@$(node -p \"require('./package.json').version\")\" version --registry=https://npm.pkg.github.com \"--//npm.pkg.github.com/:_authToken=$(gh auth token)\" >/dev/null 2>&1; then echo \"GitHub Packages: version already published, skipping\"; else npm publish --registry=https://npm.pkg.github.com \"--//npm.pkg.github.com/:_authToken=$(gh auth token)\"; fi",
    "lfm:npm": "bash scripts/publish-npm.sh",
    "lfm:jsr": "bash scripts/publish-jsr.sh",
    "lfm:publish": "pnpm lfm:gh || true; status=0; pnpm lfm:npm || status=1; pnpm lfm:jsr || status=1; exit $status"
  },
  "dependencies": {
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "~4.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "markdown",
    "remark",
    "rehype",
    "unified",
    "extended-markdown",
    "directives",
    "callouts",
    "astro",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Michael Staton <michael@lossless.group>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lossless-group/lossless-flavored-markdown-package.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false
}
