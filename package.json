{
  "name": "@lossless-group/lfm",
  "version": "0.5.0",
  "description": "Lossless Flavored Markdown \u2014 a polyglot extended markdown pipeline for remark/rehype",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./formats": {
      "import": "./dist/formats/index.js",
      "types": "./dist/formats/index.d.ts"
    },
    "./formats/yang": {
      "import": "./dist/formats/yang.js",
      "types": "./dist/formats/yang.d.ts"
    },
    "./formats/json-schema": {
      "import": "./dist/formats/json-schema.js",
      "types": "./dist/formats/json-schema.d.ts"
    },
    "./formats/plantuml": {
      "import": "./dist/formats/plantuml.js",
      "types": "./dist/formats/plantuml.d.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:only": "node --test test/*.test.mjs",
    "lfm:gh": "pnpm build && if npm view \"@lossless-group/lfm@$(node -p \"require('./package.json').version\")\" version --registry=https://npm.pkg.github.com \"--//npm.pkg.github.com/:_authToken=$(gh auth token)\" >/dev/null 2>&1; then echo \"GitHub Packages: version already published, skipping\"; else npm publish --registry=https://npm.pkg.github.com \"--//npm.pkg.github.com/:_authToken=$(gh auth token)\"; fi",
    "lfm:jsr": "pnpx jsr publish",
    "lfm:publish": "pnpm lfm:gh && pnpm lfm:jsr"
  },
  "dependencies": {
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0",
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "markdown",
    "remark",
    "rehype",
    "unified",
    "extended-markdown",
    "directives",
    "callouts",
    "astro",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Michael Staton <michael@lossless.group>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lossless-group/lossless-flavored-markdown-package"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false
}
