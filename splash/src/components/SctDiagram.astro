---
import type { CollectionEntry } from 'astro:content';

interface Props {
  /** The featured SCT example to display in the worked panel. */
  example?: CollectionEntry<'sct-examples'>;
}

const { example } = Astro.props;

const stages = [
  {
    num: '01',
    label: 'Declare Syntax',
    body: 'Add the syntax you want rendered as a component, plus the params or props it should carry.',
  },
  {
    num: '02',
    label: 'Parse Trigger',
    body: 'Wire the parser to recognize it — a peer remark plugin file that emits one canonical AST node.',
  },
  {
    num: '03',
    label: 'Component Pipeline',
    body: 'Map the AST node to a component, or a chain of them. Authors keep authoring; the renderer takes over.',
  },
];

const ex = example?.data;
const examples: Array<{ kind?: string; code?: string }> =
  Array.isArray(ex?.syntax_examples) ? (ex!.syntax_examples as any[]) : [];
---

<section class="sct" aria-labelledby="sct-heading">
  <header class="sct__header">
    <p class="folio" data-num="§">SCT — Syntax · Component · Trigger</p>
    <h2 id="sct-heading">
      Three steps from <em>your markdown</em> to <em>your renderer</em>.
    </h2>
  </header>

  <ol class="sct__stages">
    {
      stages.map((s, idx) => (
        <li class="sct__stage" style={`--i:${idx}`}>
          <span class="sct__num mono">{s.num}</span>
          <h3 class="sct__label">{s.label}</h3>
          <p class="sct__body">{s.body}</p>
          {idx < stages.length - 1 && (
            <span class="sct__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 12" width="32" height="14" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M0 6 H22" />
                <path d="M16 1 L22 6 L16 11" />
              </svg>
            </span>
          )}
        </li>
      ))
    }
  </ol>

  {
    ex && (
      <div class="sct__example">
        <header class="sct__example-header">
          <p class="folio" data-num="¶">Live example</p>
          <h3>{ex.title}</h3>
          {ex.status && <span class="pill" data-status={ex.status}>{ex.status}</span>}
        </header>

        <dl class="sct__rows">
          {examples.length > 0 && (
            <div class="sct__row">
              <dt>Syntax</dt>
              <dd>
                {ex.syntax_label && <p class="sct__row-label">{ex.syntax_label}</p>}
                <ul class="sct__syntaxes">
                  {examples.map((it) => (
                    <li>
                      {it.kind && <span class="sct__syntax-kind">{it.kind}</span>}
                      <code>{it.code}</code>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}

          {ex.parse_file && (
            <div class="sct__row">
              <dt>Parse</dt>
              <dd><span class="chip">{ex.parse_file}</span></dd>
            </div>
          )}

          {ex.component_file && (
            <div class="sct__row">
              <dt>Component</dt>
              <dd><span class="chip">{ex.component_file}</span></dd>
            </div>
          )}
        </dl>
      </div>
    )
  }
</section>

<style>
  .sct {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-card);
    position: relative;
  }
  /* The corner ticks — printer's marks. */
  .sct::before,
  .sct::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-border-strong);
  }
  .sct::before {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }
  .sct::after {
    bottom: -1px;
    right: -1px;
    border-left: 0;
    border-top: 0;
  }

  .sct__header h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    margin-top: var(--space-2);
    color: var(--color-text);
  }
  .sct__header h2 em {
    font-style: italic;
    color: var(--color-accent);
    font-weight: 500;
  }

  .sct__stages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 720px) {
    .sct__stages { grid-template-columns: 1fr; }
  }

  .sct__stage {
    position: relative;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .sct__stage::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 1px;
    background: var(--color-accent);
  }

  .sct__num {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    font-weight: 600;
  }
  .sct__label {
    font-family: var(--font__display);
    font-size: 1.18rem;
    color: var(--color-text);
    margin: 0;
    font-weight: 600;
    font-variation-settings: 'opsz' 24;
  }
  .sct__body {
    color: var(--color-text-soft);
    font-size: 0.94rem;
    line-height: 1.55;
    margin: 0;
  }

  .sct__arrow {
    position: absolute;
    top: 50%;
    right: calc(var(--space-5) * -0.85);
    transform: translateY(-50%);
    color: var(--color-text-dim);
    background: var(--color-bg-card);
    padding: 0 4px;
    z-index: 2;
  }
  @media (max-width: 720px) {
    .sct__arrow {
      top: auto;
      bottom: calc(var(--space-5) * -0.85);
      right: 50%;
      transform: translate(50%, 0) rotate(90deg);
    }
  }

  /* ─── Worked example panel ─── */
  .sct__example {
    border-top: 1px dashed var(--color-border-strong);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .sct__example-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .sct__example-header h3 {
    font-size: 1.3rem;
    color: var(--color-text);
    margin: 0;
    font-weight: 600;
  }

  .sct__rows {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .sct__row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
  }
  .sct__row:first-child { border-top: 0; padding-top: 0; }
  .sct__row dt {
    font-family: var(--font__mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    padding-top: 6px;
  }
  .sct__row dd {
    margin: 0;
    color: var(--color-text);
  }
  .sct__row-label {
    font-size: 0.84rem;
    color: var(--color-text-dim);
    margin-bottom: var(--space-2);
  }
  .sct__syntaxes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sct__syntaxes li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .sct__syntax-kind {
    font-family: var(--font__mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent);
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .sct__syntaxes code {
    font-family: var(--font__mono);
    font-size: 0.88rem;
    padding: 4px 9px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-code);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    word-break: break-all;
  }

  @media (max-width: 540px) {
    .sct { padding: var(--space-6); }
    .sct__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
