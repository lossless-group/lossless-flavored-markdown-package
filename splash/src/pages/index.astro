---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import SctDiagram from '@components/SctDiagram.astro';
import FeatureCard from '@components/FeatureCard.astro';
import { STATIC_SEO } from '@lib/seo';
import { formatDate } from '@lib/date';

// ─── Curated content ──────────────────────────────────────────────────────

const sctExamples = await getCollection('sct-examples');
const featuredExample =
  sctExamples.find((e) => e.data.featured === true) ??
  sctExamples.sort(byOrder)[0];

const features = (await getCollection('feature-highlights')).sort(byOrder);

// ─── Latest changelog teaser (optional — empty repos render gracefully) ───

const changelog = (await getCollection('changelog'))
  .filter((e) => e.data.publish !== false)
  .sort((a, b) => {
    const da = (a.data.date_modified ?? a.data.date_first_published ?? a.data.date_created ?? a.data.date) as Date | undefined;
    const db = (b.data.date_modified ?? b.data.date_first_published ?? b.data.date_created ?? b.data.date) as Date | undefined;
    const ta = da ? da.getTime() : 0;
    const tb = db ? db.getTime() : 0;
    if (tb !== ta) return tb - ta;
    return a.id < b.id ? 1 : -1;
  })
  .slice(0, 3);

function byOrder(a: { data: { order?: number | null }; id: string }, b: { data: { order?: number | null }; id: string }) {
  const ao = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const bo = b.data.order ?? Number.MAX_SAFE_INTEGER;
  if (ao !== bo) return ao - bo;
  return a.id < b.id ? -1 : 1;
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={STATIC_SEO.root.title}
  description={STATIC_SEO.root.description}
  hideHeader={true}
>
  <Header />

  <!-- ───────────────────── HERO ───────────────────── -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="folio" data-num="¶">A Lossless Group package · MIT</p>
        <h1 class="hero__headline">
          <span class="hero__brand">Lossless</span>
          <span class="hero__brand-2">Flavored Markdown</span>
        </h1>
        <p class="hero__tagline">
          MDX power without MDX's opinions. A polyglot extended-markdown pipeline —
          authors keep authoring, LFM normalizes the variations.
        </p>
        <p class="hero__philosophy">
          <em>Let content creators be content creators.</em> Identify the syntaxes
          worth supporting — and the variations on intent inside each one — then
          parse and render beautifully. LFM flexibly handles the rest.
        </p>
        <div class="hero__cta">
          <a class="btn btn-primary" href="https://jsr.io/@lossless-group/lfm" target="_blank" rel="noopener">
            Install from JSR
          </a>
          <a
            class="btn"
            href="https://github.com/lossless-group/astro-knots/blob/master/context-v/specs/Codifying-a-Comprehensive-Extended-Markdown-Flavor-and-Shared-Package.md"
            target="_blank"
            rel="noopener"
          >
            Read the spec
          </a>
        </div>
        <div class="hero__install mono" aria-label="Install with pnpm">
          <span class="hero__prompt">$</span>
          <code>pnpm add jsr:@lossless-group/lfm</code>
        </div>
      </div>

      <div class="hero__diagram">
        <SctDiagram example={featuredExample} />
      </div>
    </div>
  </section>

  <!-- ───────────────────── FEATURES ───────────────────── -->
  <section id="features" class="features">
    <div class="container">
      <header class="section-header">
        <p class="folio" data-num="§ 1">Features</p>
        <h2>What's in the box</h2>
        <p class="section-lede">
          Triggers, normalizers, and build-time enrichment. All wired together by
          <code>remarkLfm</code>; cherry-pick what you need.
        </p>
      </header>

      <div class="features__grid">
        {features.map((entry) => <FeatureCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- ───────────────────── CHANGELOG TEASER ───────────────────── -->
  {
    changelog.length > 0 && (
      <section class="recent">
        <div class="container">
          <header class="section-header">
            <p class="folio" data-num="§ 2">Recent</p>
            <h2>What shipped lately</h2>
          </header>
          <ul class="recent__list">
            {changelog.map((entry) => {
              const d = (entry.data.date_modified ?? entry.data.date_first_published ?? entry.data.date_created ?? entry.data.date) as Date | undefined;
              return (
                <li class="recent__item">
                  <a href={`${base}changelog/${entry.id}/`}>
                    <div class="recent__meta mono">
                      {d && <time datetime={d.toISOString()}>{formatDate(d)}</time>}
                      {entry.data.at_semantic_version && (
                        <span class="recent__ver">{entry.data.at_semantic_version}</span>
                      )}
                    </div>
                    <h3 class="recent__title">{entry.data.title ?? entry.id}</h3>
                    {entry.data.lede && <p class="recent__lede">{entry.data.lede}</p>}
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="recent__all">
            <a href={`${base}changelog/`}>Read the full changelog →</a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    padding: var(--space-16) 0 var(--space-20);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-16);
    align-items: center;
  }
  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 560px;
  }

  .hero__headline {
    font-family: var(--font__display);
    font-size: clamp(2.4rem, 5.4vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0;
    font-variation-settings: 'opsz' 72;
  }
  .hero__brand {
    display: block;
    color: var(--color-text);
  }
  .hero__brand-2 {
    display: block;
    background: var(--gradient-thread);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
    font-weight: 400;
  }

  .hero__tagline {
    font-size: 1.16rem;
    line-height: 1.55;
    color: var(--color-text);
    max-width: 52ch;
  }

  .hero__philosophy {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    max-width: 56ch;
  }
  .hero__philosophy em {
    color: var(--color-text);
    font-style: italic;
    font-weight: 600;
  }

  .hero__cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .hero__install {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-code);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    color: var(--color-text-soft);
    margin-top: var(--space-3);
    max-width: max-content;
  }
  .hero__prompt {
    color: var(--color-accent);
    user-select: none;
  }

  .hero__diagram {
    /* SctDiagram brings its own card styling */
  }

  /* ─── Section header ─── */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
    max-width: 720px;
  }
  .section-header h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    color: var(--color-text);
  }
  .section-lede {
    color: var(--color-text-soft);
    font-size: 1.04rem;
    line-height: 1.6;
  }
  .section-lede code {
    font-family: var(--font__mono);
    font-size: 0.86em;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-code);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  /* ─── Features ─── */
  .features {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  /* ─── Recent ─── */
  .recent {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }
  .recent__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent__item a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
    color: var(--color-text);
  }
  .recent__item a:hover {
    background: color-mix(in oklab, var(--color-accent) 5%, transparent);
    text-decoration: none;
  }
  .recent__item a:hover .recent__title {
    color: var(--color-accent);
  }
  .recent__meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: 0.78rem;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }
  .recent__ver {
    font-family: var(--font__mono);
    color: var(--color-accent);
  }
  .recent__title {
    font-size: 1.1rem;
    font-family: var(--font__display);
    font-weight: 600;
    margin: 0;
    transition: color var(--transition-fast);
  }
  .recent__lede {
    font-size: 0.95rem;
    color: var(--color-text-soft);
    line-height: 1.55;
    max-width: 80ch;
  }
  .recent__all {
    margin-top: var(--space-6);
    font-family: var(--font__mono);
    font-size: 0.9rem;
  }
</style>

