---
/**
 * Live feature demo.
 *
 * Every example on this page is a **real markdown file** in
 * `src/content/lfm-demos/`, loaded as a content collection and run through the
 * real `parseMarkdown` at build time. Nothing is a string literal in this file
 * and nothing is hand-written illustration, which matters for two reasons:
 * the examples are editable by anyone without touching a page, and the page
 * exercises the actual authoring path — a document on disk going through the
 * pipeline — rather than a string that skips it.
 *
 * The same files are the fixtures in `test/demo-fixtures.test.mjs`, so a
 * change to an example is checked by the suite as well as rendered here.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PipelineDemo from '@components/PipelineDemo.astro';
import '@styles/mermaid.css';
import { parseMarkdown, nestHeadings, filterHeadings } from '../../../src/index.ts';
import { mermaid, graphviz, jsonCanvas, vegaLite, yang, jsonSchema } from '../../../src/formats/index.ts';
import { plantuml } from '../../../src/formats/plantuml.ts';

const FENCE_FORMATS = [mermaid, graphviz, jsonCanvas, vegaLite, yang, jsonSchema, plantuml];

const find = (node: any, pred: (n: any) => boolean, out: any[] = []): any[] => {
  for (const child of node?.children ?? []) {
    if (pred(child)) out.push(child);
    find(child, pred, out);
  }
  return out;
};
const directive = (tree: any, name: string) =>
  find(tree, (n: any) => n.type === 'containerDirective' && n.name === name)[0];

/**
 * What to show in the payload pane, per demo.
 *
 * The markdown lives in files; this stays in code, because *which* slice of the
 * tree is interesting genuinely differs per feature and is not something
 * frontmatter should be pretending to express.
 */
const PAYLOAD: Record<string, (tree: any) => unknown> = {
  'eyebrow-heading-subheading': (t) => {
    const n = directive(t, 'heading-block');
    return { hName: n.data.hName, hProperties: n.data.hProperties, headingBlock: n.data.headingBlock };
  },
  'table-of-contents': (t) => t.data.headings,
  callouts: (t) => {
    const n = directive(t, 'callout');
    return { name: n.name, attributes: n.attributes, data: n.data };
  },
  citations: (t) => t.data.citations.ordered.map((c: any) => ({
    index: c.index, identifier: c.identifier, title: c.title,
    source: c.source, publishedDate: c.publishedDate,
  })),
  'image-carousel': (t) => directive(t, 'image-carousel').data.carousel,
  'link-rollup': (t) => directive(t, 'link-rollup').data.linkPreviewSpec,
};

const entries = (await getCollection('lfm-demos'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const demos = [];
for (const entry of entries) {
  const source = entry.body.trim();
  const tree = await parseMarkdown(source, { codeFences: { formats: FENCE_FORMATS } });

  let result: unknown;
  let fence: any = null;
  if (entry.data.kind === 'fence') {
    fence = find(tree, (n: any) => n.type === 'code')[0].data.fence;
    result = fence;
  } else {
    result = PAYLOAD[entry.id]?.(tree) ?? null;
  }

  demos.push({ entry, source, tree, result, fence });
}

/** The table-of-contents demo renders an actual ToC from its own outline. */
const tocDemo = demos.find((d) => d.entry.id === 'table-of-contents');
const toc = tocDemo
  ? nestHeadings(filterHeadings(tocDemo.tree.data.headings, 2, 4).filter((h: any) => !h.inContainer))
  : [];

/** The heading-block demo renders its own hgroup from the parsed payload. */
const hb = demos.find((d) => d.entry.id === 'eyebrow-heading-subheading');
const headingBlockText = hb ? find(hb.tree, (n: any) => n.type === 'heading')[0].data.headingText : '';

/** JSON Canvas geometry, for the dependency-free SVG below. */
const canvasDemo = demos.find((d) => d.entry.id === 'fence-jsoncanvas');

// Read the registry off the exports so the table can never drift from code.
const registry = FENCE_FORMATS.map((f) => ({
  name: f.name, langs: f.match, parses: typeof f.parse === 'function',
}));

const featureDemos = demos.filter((d) => d.entry.data.kind !== 'fence');
const fenceDemos = demos.filter((d) => d.entry.data.kind === 'fence');
---

<BaseLayout
  title="Live demo — every feature, parsed at build time"
  description="Real markdown files on the left, the payload LFM actually returned on the right — every value computed at build time by the real pipeline."
>
  <section class="intro">
    <div class="container">
      <p class="folio" data-num="§">Demo</p>
      <h1>Every feature, parsed at build time</h1>
      <p class="intro__lede">
        Each example is a markdown file in <code>src/content/lfm-demos/</code>.
        On the right is what <code>parseMarkdown</code> handed back when this
        page was built — not an illustration of it.
      </p>
      <p class="intro__note">
        LFM returns an <strong>AST, not HTML</strong>. Deciding what a reader sees
        belongs to the render layer, and this splash is one render layer among
        many — so the payload is the honest thing to show, with a rendering
        underneath wherever it makes the point better. The same files are the
        fixtures the test suite runs against.
      </p>
      <nav class="intro__jump" aria-label="Jump to a feature">
        {demos.map((d) => <a href={`#${d.entry.id}`}>{d.entry.data.title}</a>)}
      </nav>
    </div>
  </section>

  <section class="demos">
    <div class="container">

      {featureDemos.map((d) => (
        <PipelineDemo
          id={d.entry.id}
          title={d.entry.data.title}
          plugin={d.entry.data.plugin}
          note={d.entry.data.note}
          source={d.source}
          resultLabel={d.entry.data.result_label}
          result={d.result}
        >
          {d.entry.id === 'eyebrow-heading-subheading' && (
            <hgroup slot="rendered" class="heading-block">
              <p class="heading-block-eyebrow eyebrow">{(d.result as any).headingBlock.eyebrow}</p>
              <h2>{headingBlockText}</h2>
              {(d.result as any).headingBlock.subheadings.map((sub: string) => (
                <p class="heading-block-subheading subheading">{sub}</p>
              ))}
            </hgroup>
          )}

          {d.entry.id === 'table-of-contents' && (
            <div slot="rendered">
              <p class="toc__caption">
                <code>nestHeadings(filterHeadings(outline, 2, 4).filter(h =&gt; !h.inContainer))</code>
              </p>
              <ul class="toc">
                {toc.map((node: any) => (
                  <li>
                    {node.eyebrow && <span class="toc__eyebrow">{node.eyebrow}</span>}
                    <a href={`#${node.id}`}>{node.text}</a>
                    {node.children.length > 0 && (
                      <ul>{node.children.map((c: any) => <li><a href={`#${c.id}`}>{c.text}</a></li>)}</ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </PipelineDemo>
      ))}

      <div class="fences" id="code-fences">
        <h2 class="fences__title">Code fences — every shipped handler</h2>
        <p class="fences__lede">
          The registry ships <strong>empty</strong>; you pay for the formats you name.
          What a handler <em>does</em> depends entirely on who draws the diagram —
          which is why some parse to a tree, some to a URL, and two deliberately
          parse nothing at all.
        </p>

        <div class="fences__table-wrap">
          <table class="fences__table">
            <thead><tr><th>Handler</th><th>Claims</th><th>Parses?</th></tr></thead>
            <tbody>
              {registry.map((r) => (
                <tr>
                  <td><code>{r.name}</code></td>
                  <td>{r.langs.map((l: string) => <code class="lang">{l}</code>)}</td>
                  <td>{r.parses ? 'yes' : 'claims the language only'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {fenceDemos.map((d) => (
          <PipelineDemo
            id={d.entry.id}
            title={d.entry.data.title}
            plugin={`draws: ${d.entry.data.draws}`}
            note={d.entry.data.note}
            source={d.source}
            resultLabel={d.entry.data.result_label}
            result={d.result}
          >
            <div slot="rendered" class="fences__out">
              {d.fence?.parsed?.tree && (
                <pre class="fences__tree"><code>{d.fence.parsed.tree}</code></pre>
              )}

              {d.fence?.parsed?.svg && (
                <>
                  <img class="fences__img" src={d.fence.parsed.svg}
                       alt={`PlantUML ${d.fence.parsed.kind ?? ''} diagram, rendered by the PlantUML server`}
                       loading="lazy" />
                  <p class="fences__url">
                    Detected kind <code>{d.fence.parsed.kind ?? 'unknown'}</code>; the
                    <code>@startuml</code> wrapper was {d.fence.parsed.wrapped ? 'authored' : 'added for you'}.
                    The source travels inside that URL — <code>createPlantUml({'{'} server {'}'})</code> points it
                    at a self-hosted instance.
                  </p>
                </>
              )}

              {d.entry.data.handler === 'mermaid' && (
                <div class="fences__mount mermaid" data-mermaid={d.tree.children[0].value}>
                  <p class="fences__pending">Rendering with mermaid.js…</p>
                </div>
              )}
              {d.entry.data.handler === 'graphviz' && (
                <div class="fences__mount" data-dot={d.tree.children[0].value}>
                  <p class="fences__pending">Rendering with @viz-js/viz…</p>
                </div>
              )}
              {d.entry.data.handler === 'vega-lite' && (
                <div class="fences__mount" data-vega={JSON.stringify(d.fence.parsed.spec)}>
                  <p class="fences__pending">Rendering with vega-embed…</p>
                </div>
              )}

              {d.entry.data.handler === 'jsoncanvas' && (() => {
                const ns = d.fence.parsed.nodes;
                const pad = 20;
                const maxX = Math.max(...ns.map((n: any) => n.x + n.width)) + pad;
                const maxY = Math.max(...ns.map((n: any) => n.y + n.height)) + pad;
                const byId = Object.fromEntries(ns.map((n: any) => [n.id, n]));
                return (
                  <svg class="fences__canvas" viewBox={`-${pad} -${pad} ${maxX + pad} ${maxY + pad}`}
                       role="img" aria-label="JSON Canvas document rendered from the parsed nodes and edges">
                    {d.fence.parsed.edges.map((e: any) => {
                      const a = byId[e.fromNode], b = byId[e.toNode];
                      if (!a || !b) return null;
                      const x1 = a.x + a.width, y1 = a.y + a.height / 2;
                      const x2 = b.x, y2 = b.y + b.height / 2;
                      return (
                        <>
                          <line x1={x1} y1={y1} x2={x2} y2={y2} class="edge" />
                          {e.label && <text x={(x1 + x2) / 2} y={(y1 + y2) / 2 - 6} class="edge-label">{e.label}</text>}
                        </>
                      );
                    })}
                    {ns.map((n: any) => (
                      <>
                        <rect x={n.x} y={n.y} width={n.width} height={n.height} rx="6" class="node" />
                        <text x={n.x + n.width / 2} y={n.y + n.height / 2 + 5} class="node-label">{n.text}</text>
                      </>
                    ))}
                  </svg>
                );
              })()}
            </div>
          </PipelineDemo>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  // The render layer, doing its half.
  //
  // LFM stops at the AST — mermaid and graphviz get recognition only, and
  // vega-lite gets a parsed spec. Something still has to draw, and that
  // something is a client renderer the *site* chooses. Loaded from a CDN, on
  // this page only, deliberately not a site-wide dependency: the whole point
  // of the empty registry is that a splash shouldn't pay for a diagram type it
  // never uses. Same pattern as /formats.
  //
  // Every renderer fails soft. A diagram that cannot draw falls back to a note,
  // because the payload above it already says what it was going to show.

  const load = (src: string) =>
    new Promise<void>((res, rej) => {
      const el = document.createElement('script');
      el.src = src;
      el.onload = () => res();
      el.onerror = () => rej(new Error(src));
      document.head.appendChild(el);
    });

  const fail = (mount: Element, what: string) => {
    mount.innerHTML =
      `<p class="fences__pending">${what} unavailable — the payload above still describes the diagram.</p>`;
  };

  // ── mermaid ──────────────────────────────────────────────────────────────
  // Mermaid is not unstyled by default: it injects its own stylesheet into
  // every generated SVG from `themeVariables`. Feeding it the site's design
  // tokens is what makes a diagram belong here rather than look imported. See
  // src/lib/mermaid-theme.ts for the full reasoning.
  //
  // It also bakes that stylesheet in at render time, so a mode toggle cannot
  // be handled by CSS — the diagram has to be drawn again.
  const mermaidMount = document.querySelector<HTMLElement>('[data-mermaid]');
  if (mermaidMount) {
    (async () => {
      try {
        const [mod, theme] = await Promise.all([
          import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs') as any,
          import('../lib/mermaid-theme.ts'),
        ]);
        const mermaid = mod.default;
        const source = mermaidMount.dataset.mermaid!;
        let n = 0;

        const draw = async () => {
          try {
            mermaid.initialize(theme.mermaidConfig());
            // A fresh id each pass — Mermaid caches per id, so reusing one
            // returns the previous render with the previous palette.
            const { svg } = await mermaid.render(`demo-mermaid-${n++}`, source);
            mermaidMount.innerHTML = svg;
          } catch {
            fail(mermaidMount, 'mermaid.js');
          }
        };

        await draw();
        theme.onModeChange(draw);
      } catch {
        fail(mermaidMount, 'mermaid.js');
      }
    })();
  }

  // ── graphviz ─────────────────────────────────────────────────────────────
  const dotMount = document.querySelector<HTMLElement>('[data-dot]');
  if (dotMount) {
    (async () => {
      try {
        await load('https://cdn.jsdelivr.net/npm/@viz-js/viz@3/lib/viz-standalone.js');
        const viz = await (window as any).Viz.instance();
        dotMount.replaceChildren(viz.renderSVGElement(dotMount.dataset.dot!));
      } catch {
        fail(dotMount, '@viz-js/viz');
      }
    })();
  }

  // ── vega-lite ────────────────────────────────────────────────────────────
  const vegaMount = document.querySelector<HTMLElement>('[data-vega]');
  if (vegaMount) {
    (async () => {
      try {
        await load('https://cdn.jsdelivr.net/npm/vega@5');
        await load('https://cdn.jsdelivr.net/npm/vega-lite@5');
        await load('https://cdn.jsdelivr.net/npm/vega-embed@6');
        vegaMount.replaceChildren();
        await (window as any).vegaEmbed(vegaMount, JSON.parse(vegaMount.dataset.vega!), {
          actions: false,
          renderer: 'svg',
        });
      } catch {
        fail(vegaMount, 'vega-embed');
      }
    })();
  }
</script>

<style>
  .intro { padding: var(--space-16) 0 var(--space-8); }
  .intro h1 { margin: var(--space-2) 0 var(--space-4); }
  .intro__lede { font-size: 1.15rem; max-width: 62ch; color: var(--color-text-soft); }
  .intro__note { max-width: 62ch; color: var(--color-text-dim); font-size: 0.95rem; }

  .intro__jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    font-size: 0.88rem;
  }

  .demos { padding-bottom: var(--space-20); }

  /* The class contract from lfm-heading-blocks, styled the way a consuming
     site would. The scoped `.heading-block *` selector is what outranks a
     site's own `.prose p` rules — the bare `.eyebrow` alone would lose. */
  .heading-block { margin: 0; }

  .heading-block .heading-block-eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .heading-block h2 { margin: 0; line-height: 1.25; }

  .heading-block .heading-block-subheading {
    margin: var(--space-2) 0 0;
    color: var(--color-text-dim);
    font-size: 0.98rem;
  }

  .toc__caption {
    margin: 0 0 var(--space-3);
    font-size: 0.78rem;
    color: var(--color-text-dimmer);
    overflow-x: auto;
  }

  .toc { margin: 0; padding-left: var(--space-5); }
  .toc ul { padding-left: var(--space-5); }
  .toc li { margin: var(--space-1) 0; }

  .fences { margin-bottom: var(--space-10); }
  .fences__title { margin: var(--space-8) 0 var(--space-2); }
  .fences__lede { max-width: 62ch; color: var(--color-text-soft); }

  .fences__table-wrap { overflow-x: auto; margin: var(--space-5) 0 var(--space-8); }
  .fences__table { border-collapse: collapse; font-size: 0.9rem; min-width: 34rem; }
  .fences__table th, .fences__table td {
    text-align: left;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .fences__table th { color: var(--color-text-dimmer); font-weight: 600; font-size: 0.78rem;
    letter-spacing: 0.06em; text-transform: uppercase; }
  .fences__table .lang + .lang { margin-left: var(--space-2); }

  /* The tree diagrams are the output for yang / json-schema — monospace and
     unwrapped, because column alignment carries the structure. */
  .fences__tree {
    margin: 0;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.5;
    white-space: pre;
  }

  .fences__out > * + * { margin-top: var(--space-4); }

  .fences__img,
  .fences__canvas { max-width: 100%; height: auto; display: block; }

  .fences__mount :global(svg) { max-width: 100%; height: auto; }

  .fences__pending { margin: 0; font-size: 0.88rem; color: var(--color-text-dimmer); font-style: italic; }

  .fences__canvas { max-height: 16rem; }
  .fences__canvas :global(.node) { fill: var(--color-bg-elevated); stroke: var(--color-border-accent); }
  .fences__canvas :global(.node-label) {
    fill: var(--color-text); font-size: 14px; text-anchor: middle;
    font-family: var(--font, system-ui);
  }
  .fences__canvas :global(.edge) { stroke: var(--color-text-dim); stroke-width: 1.5; }
  .fences__canvas :global(.edge-label) {
    fill: var(--color-text-dim); font-size: 11px; text-anchor: middle;
    font-family: var(--font, system-ui);
  }

  .fences__url { margin: 0; font-size: 0.9rem; color: var(--color-text-soft); }

  .toc__eyebrow {
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
