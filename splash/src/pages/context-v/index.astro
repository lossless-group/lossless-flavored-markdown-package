---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { STATIC_SEO } from '@lib/seo';
import { formatDate } from '@lib/date';

const entries = (await getCollection('context-v'))
  .filter((e) => e.data.publish !== false);

// Group by top-level subdirectory (specs, habits, prompts, etc.).
const groups = new Map<string, typeof entries>();
for (const entry of entries) {
  const segments = entry.id.split('/');
  const group = segments.length > 1 ? segments[0] : 'general';
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push(entry);
}

// Sort each group: by title alphabetically.
for (const arr of groups.values()) {
  arr.sort((a, b) => {
    const ta = (a.data.title ?? a.id).toString().toLowerCase();
    const tb = (b.data.title ?? b.id).toString().toLowerCase();
    return ta < tb ? -1 : ta > tb ? 1 : 0;
  });
}

// Sort groups: known order first, then alphabetical.
const groupOrder = ['specs', 'habits', 'prompts', 'reminders', 'explorations', 'issues', 'general'];
const sortedGroups = Array.from(groups.entries()).sort(([a], [b]) => {
  const ai = groupOrder.indexOf(a);
  const bi = groupOrder.indexOf(b);
  const ax = ai === -1 ? Number.MAX_SAFE_INTEGER : ai;
  const bx = bi === -1 ? Number.MAX_SAFE_INTEGER : bi;
  if (ax !== bx) return ax - bx;
  return a < b ? -1 : 1;
});

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={STATIC_SEO.contextV.title}
  description={STATIC_SEO.contextV.description}
>
  <main class="page">
    <div class="container-narrow">
      <header class="page__header">
        <p class="folio" data-num="§">Context Vigilance</p>
        <h1>The why beneath the code</h1>
        <p class="page__lede">
          Specs, habits, and reflections that shape how LFM is built. Versioned
          context, intentionally legible. The
          <a href="https://github.com/lossless-group/astro-knots/blob/master/context-v/specs/Codifying-a-Comprehensive-Extended-Markdown-Flavor-and-Shared-Package.md" target="_blank" rel="noopener">
            full LFM spec lives in astro-knots
          </a>; this page collects the LFM-specific notes that ride alongside the package.
        </p>
      </header>

      {
        entries.length === 0 ? (
          <p class="page__empty">
            No context-v entries yet — they'll appear here as they're authored.
          </p>
        ) : (
          sortedGroups.map(([group, items]) => (
            <section class="ctx-group">
              <h2 class="ctx-group__title">{group}</h2>
              <ul class="entry-list">
                {items.map((entry) => {
                  const d = (entry.data.date_modified ?? entry.data.date_updated ?? entry.data.date_created) as Date | undefined;
                  return (
                    <li class="entry-list__item">
                      <a href={`${base}context-v/${entry.id}/`}>
                        <div class="entry-list__meta mono">
                          {d && <time datetime={d.toISOString()}>{formatDate(d)}</time>}
                          {entry.data.semantic_version && (
                            <span class="entry-list__ver">{entry.data.semantic_version}</span>
                          )}
                          {entry.data.status && (
                            <span class="pill" data-status={entry.data.status}>{entry.data.status}</span>
                          )}
                        </div>
                        <h3 class="entry-list__title">{entry.data.title ?? entry.id}</h3>
                        {entry.data.lede && <p class="entry-list__lede">{entry.data.lede}</p>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .page { padding: var(--space-12) 0 var(--space-16); }
  .page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }
  .page__header h1 {
    font-size: clamp(2rem, 4.6vw, 2.8rem);
    color: var(--color-text);
    font-weight: 500;
    font-variation-settings: 'opsz' 60;
  }
  .page__lede {
    color: var(--color-text-soft);
    font-size: 1.06rem;
    line-height: 1.6;
    max-width: 70ch;
  }
  .page__lede a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .page__empty {
    color: var(--color-text-dim);
    font-style: italic;
    padding: var(--space-12) 0;
  }

  .ctx-group {
    margin-bottom: var(--space-12);
  }
  .ctx-group__title {
    font-family: var(--font__mono);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .entry-list__item a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    transition: padding-left var(--transition-fast);
  }
  .entry-list__item a:hover {
    text-decoration: none;
    padding-left: var(--space-3);
  }
  .entry-list__item a:hover .entry-list__title {
    color: var(--color-accent);
  }
  .entry-list__meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: 0.78rem;
    color: var(--color-text-dim);
  }
  .entry-list__ver { color: var(--color-accent); }
  .entry-list__title {
    font-size: 1.18rem;
    font-family: var(--font__display);
    font-weight: 600;
    margin: 0;
    transition: color var(--transition-fast);
  }
  .entry-list__lede {
    color: var(--color-text-soft);
    font-size: 0.94rem;
    line-height: 1.55;
    max-width: 75ch;
  }
</style>
